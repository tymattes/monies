# Host port the app is published on
APP_PORT=3000

# Postgres (required: set a password; avoid URL-special characters like @ : / ? #)
POSTGRES_USER=monies
POSTGRES_DB=monies
POSTGRES_PASSWORD=change-me
# Host port for the DB (bound to 127.0.0.1), used for local development
DB_PORT=5432

# Local development only (npm run dev, npm run db:migrate).
# The containerized app gets its own DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgres://monies:change-me@localhost:5432/monies

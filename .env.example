# Host port the app is published on
APP_PORT=1717

# Postgres (required: set a password; avoid URL-special characters like @ : / ? #)
POSTGRES_USER=monies
POSTGRES_DB=monies
POSTGRES_PASSWORD=change-me
# Host port for the DB (bound to 127.0.0.1), used for local development
DB_PORT=5432

# Local development only (npm run dev, npm run db:migrate).
# The containerized app gets its own DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgres://monies:change-me@localhost:5432/monies

# Auth (Better Auth). Required: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL users open the app at. Must match the address in the browser
# (scheme + host + port), or sign-in requests are rejected. Defaults to http://localhost:${APP_PORT}.
# BETTER_AUTH_URL=http://localhost:1717

# Server timezone (IANA name). Decides which calendar month counts as "this month" for budgets.
# TZ=America/Chicago
